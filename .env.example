# ── Required ────────────────────────────────────────────────────────────────
# Signing key for JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production with the default value.
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ────────────────────────────────────────────────────────────────
# SQLite by default, so the app runs with no setup at all.
DATABASE_URL=sqlite:///./pagepulse.db
# PostgreSQL (used by docker-compose):
# DATABASE_URL=postgresql+psycopg://pagepulse:pagepulse@db:5432/pagepulse

# ── Environment ─────────────────────────────────────────────────────────────
# development | production | test
# In production the app refuses to start with a default SECRET_KEY.
ENVIRONMENT=development

# ── Facebook Graph API (optional) ───────────────────────────────────────────
# Leave empty to run on the built-in demo dataset. With a page access token
# set, POST /api/pages/live pulls real data for a page you administer.
# The token needs: pages_read_engagement, pages_show_list, read_insights
FB_GRAPH_TOKEN=
FB_GRAPH_VERSION=v21.0
FB_GRAPH_TIMEOUT_SECONDS=10

# ── Security ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Empty means same-origin only,
# which is what the bundled dashboard needs.
CORS_ORIGINS=

# Set to false only when a proxy or gateway in front of the app already
# rate-limits requests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Demo data ───────────────────────────────────────────────────────────────
# Seed the three sample pages on first start, so a fresh install has
# something to look at immediately.
SEED_DEMO_ON_STARTUP=false
